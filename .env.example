# ========================================
# 🚀 NVME.live - Environment Variables
# ========================================

# Server
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# ========================================
# 🔑 NVIDIA API (Free Tier)
# ========================================
# Get your key from: https://build.nvidia.com/settings/api-keys
# Free tier: 1,000+ credits, 40 requests per minute
NVIDIA_API_KEY=nvapi-your_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ========================================
# 🔑 Kimi API (Moonshot AI)
# ========================================
# Get your key from: https://platform.kimi.ai
# Kimi K3: 1M token context, 2.8 trillion parameters
MOONSHOT_API_KEY=your_kimi_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_DEFAULT_MODEL=kimi-k3

# ========================================
# 🗄️ Database
# ========================================
DATABASE_URL=postgresql://neondb_owner:your_password@your_host/your_db?sslMode=require
REDIS_URL=redis://localhost:6379

# ========================================
# 🔐 JWT & Auth
# ========================================
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# express-session secret (falls back to JWT_SECRET + ':session' if unset)
SESSION_SECRET=your_super_secret_session_key_change_this

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ========================================
# ✉️ Email (optional — verification / password reset)
# ========================================
# No provider configured = emails are logged to the server console
# instead of sent (dev register responses include devVerificationUrl).
# Sending real mail also needs the optional `nodemailer` package
# (npm install nodemailer). Use EITHER a full SMTP_URL:
# SMTP_URL=smtps://user:pass@smtp.example.com
# OR host/auth parts:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@nvme.live

# ========================================
# 💰 PayPal Payments
# ========================================
PAYPAL_CLIENT_ID=sb_your_sandbox_client_id
PAYPAL_CLIENT_SECRET=sandbox_your_secret_key
PAYPAL_MODE=sandbox

# Platform Fee (70% to creators)
CREATOR_PAYOUT_PERCENT=70
PLATFORM_FEE_PERCENT=30
MIN_PAYOUT_AMOUNT=5.00
PAYOUT_DAYS=7

# ========================================
# 📹 Video Storage
# ========================================
# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# OR AWS S3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=nvme-video-storage

# ========================================
# 🎬 WebRTC / TURN
# ========================================
TURN_SERVER=turn:turn.nvme.live:3478
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_credential
STUN_SERVER=stun:stun.l.google.com:19302

# ========================================
# 💎 Ethereum (Crypto)
# ========================================
ETH_RPC_URL=https://mainnet.infura.io/v3/your_key
ETH_PRIVATE_KEY=your_eth_private_key

# ========================================
# 🎁 Free Trial
# ========================================
TRIAL_DAYS=7
MAX_STREAM_DURATION=14400
MAX_VIDEO_SIZE=2147483648

# ========================================
# 🚀 Deployment
# ========================================
PM2_NAME=nvme-platform

# ========================================
# 🔔 Web Push (VAPID)
# ========================================
# Generate a key pair once with:
#   npx web-push generate-vapid-keys
# Push is disabled (routes no-op) until these are set.
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@nvme.live
