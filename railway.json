{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100,
    "restart": {
      "policy": "on-failure",
      "maxRetries": 3
    }
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": 3000,
    "HOST": "0.0.0.0"
  }
}
